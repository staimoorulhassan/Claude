# ═══════════════════════════════════════════════════════════
#  Lead Generation Setup — environment variables
#  Copy to .env and fill in. Never commit .env
# ═══════════════════════════════════════════════════════════

# ── Vapi (STT / LLM / TTS / Voice-AI provider only) ──────
VAPI_PRIVATE_KEY=7f934503-2faa-48ca-b46b-ade35a66b77c
VAPI_ASSISTANT_ID=37c1cb25-28c7-41b4-bdf0-dcea72331856
VAPI_PHONE_NUMBER_ID=bec20f66-2bc6-41fc-856f-c51779736e87
VAPI_API_BASE=https://api.vapi.ai

# ── Hub control API (vapi-control-vercel on Vercel) ───────
SERVER_URL=https://YOUR-PROJECT.vercel.app/vapi   # Vapi webhook target
SERVER_SECRET=sc-webhook-2026                      # x-vapi-secret header
CONTROL_ADMIN_TOKEN=sc-admin-2026                  # admin endpoints

# ── AI agent / voice ──────────────────────────────────────
COMPANY_NAME=SeniorCare
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Savannah
VAPI_VOICE_SPEED=1.0
STT_PROVIDER=deepgram
STT_MODEL=nova-2

# ── Transfer target ───────────────────────────────────────
VERIFIER_NUMBER=+1XXXXXXXXXX   # ViciDial closer-queue DID or direct verifier

# ── ViciDial server ───────────────────────────────────────
VICIDIAL_HOST=46.225.136.17
VICIDIAL_AMI_PORT=5038
VICIDIAL_AMI_USER=cron                # from ViciDial manager.conf
VICIDIAL_AMI_SECRET=                  # fill in

# ── AVR Asterisk (Lead-Gen hub's own Asterisk) ────────────
AVR_AMI_URL=http://avr-ami:3002       # internal Docker service
AVR_ASTERISK_AMI_SECRET=avr-ami-2026  # set same in asterisk/manager.conf

# ── avr-app (dashboard) ───────────────────────────────────
AVR_APP_JWT_SECRET=change-me-jwt-secret

# ── Vercel (for setup.js) ─────────────────────────────────
VERCEL_TOKEN=                          # your Vercel token
VERCEL_PROJECT_ID=prj_pTwnSIiSdCFBNmVXQMCv99Sg4HdD
