# ============================================================================
# Lead Generation Setup — configuration
# Copy this file to config/.env and fill in real values. NEVER commit config/.env.
# Every value here is a swappable knob. The vapi-control service reads these and
# substitutes the __TOKENS__ in ai-agent/assistant.vapi.json at deploy time.
# ============================================================================

# ----- Vapi account -----
VAPI_API_BASE=https://api.vapi.ai
VAPI_PRIVATE_KEY=                       # Vapi private/secret API key (server-side). SECRET.
VAPI_PUBLIC_KEY=                        # Vapi public key (web SDK), optional
VAPI_ASSISTANT_ID=                      # Filled in after first deploy; used for updates

# ----- Brand / campaign -----
COMPANY_NAME=Your Pharmacy Delivery Brand

# ----- LLM (the "brain") — swappable -----
# Examples: openai/gpt-4o, openai/gpt-4o-mini, anthropic/claude-sonnet-4-6,
#           groq/llama-3.3-70b-versatile, google/gemini-1.5-pro
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ----- Voice / TTS — Vapi "Savannah" by default, swappable -----
# Use provider=vapi for Vapi's own voices (Savannah, etc.).
# To swap to another TTS: e.g. provider=11labs voiceId=<id>, provider=cartesia voiceId=<id>.
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Savannah
# Speed: Vapi voice speed is a MULTIPLIER (1.0 = normal; usable range ~0.5–2.0).
# You asked for "speed 7" — that's the dashboard slider value, not the API value.
# Confirm the mapping in your Vapi dashboard and set the API multiplier here.
# 1.0 is normal pace; raise gently (e.g. 1.15–1.3) for a brisker delivery.
VAPI_VOICE_SPEED=1.0

# ----- STT / transcriber — swappable -----
# Examples: deepgram/nova-2, deepgram/nova-3, assembly-ai, gladia
STT_PROVIDER=deepgram
STT_MODEL=nova-2

# ----- Prompt source -----
# If true, deploy script injects ai-agent/prompt.md into the assistant system message.
PROMPT_FROM_FILE=true

# ----- Verifier (transfer target) -----
VERIFIER_NUMBER=+1XXXXXXXXXX            # US verifier number for warm/3-way transfer

# ----- vapi-control service (webhook + provider swap + Vapi server-url) -----
SERVER_URL=https://your-public-host/vapi   # public URL Vapi calls back (use ngrok/cloud in dev)
SERVER_SECRET=change-me-long-random         # shared secret to verify Vapi webhook signatures. SECRET.
CONTROL_PORT=8080
CONTROL_ADMIN_TOKEN=change-me-admin-token    # bearer token to protect the /swap and /deploy endpoints

# ============================================================================
# ViciDial — outbound dialer that places the calls
# Choose ONE integration mode in docs/vicidial-setup.md: SIP trunk (recommended) or API.
# ============================================================================

# ----- ViciDial server / API (non-agent / Click-to-Call API) -----
VICIDIAL_BASE_URL=https://your-vicidial-server
VICIDIAL_API_USER=                      # ViciDial API user with non-agent API access
VICIDIAL_API_PASS=                      # SECRET
VICIDIAL_CAMPAIGN_ID=PHARMA01
VICIDIAL_SOURCE=leadgen

# ----- SIP bridge between ViciDial/Asterisk and Vapi (BYO SIP trunk) -----
# These mirror the Vapi byo-sip-trunk credential you create (see docs/vapi-setup.md).
VAPI_SIP_TRUNK_CREDENTIAL_ID=           # id of the byo-sip-trunk credential in Vapi
VAPI_SIP_URI=sip:leadgen@sip.vapi.ai    # the SIP URI ViciDial dials to reach the assistant
VICIDIAL_SIP_TRUNK_NAME=vapi_trunk      # carrier/trunk name configured inside ViciDial

# ============================================================================
# avr-ami (Asterisk call control — reliable transfer without Twilio dependency)
# ============================================================================
AVR_AMI_URL=http://localhost:6006        # or http://avr-ami:6006 inside Docker compose
AMI_USERNAME=avr
AMI_PASSWORD=change-me-match-manager-conf   # must match asterisk-config/manager.conf

# ============================================================================
# avr-app (dashboard)
# ============================================================================
JWT_SECRET=change-me-long-random-string

# ============================================================================
# Privacy / data
# ============================================================================
# Vapi recording is DISABLED in assistant.vapi.json (recordingEnabled: false).
# All call outcomes are stored ONLY in data/leads.jsonl (local, gitignored).
# DO NOT re-enable Vapi recording without explicit client/legal approval.
