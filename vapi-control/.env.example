# ── Vapi ──────────────────────────────────────────────────────────────────────
VAPI_PRIVATE_KEY=            # Vapi secret key
VAPI_API_BASE=https://api.vapi.ai
VAPI_ASSISTANT_ID=           # filled in after first deploy

# ── Campaign / brand ──────────────────────────────────────────────────────────
COMPANY_NAME=Your Pharmacy Delivery Brand
VERIFIER_NUMBER=+1XXXXXXXXXX

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ── Voice (Vapi Savannah by default) ──────────────────────────────────────────
VAPI_VOICE_PROVIDER=vapi
VAPI_VOICE_ID=Savannah
VAPI_VOICE_SPEED=1.0         # multiplier: 1.0 = normal, ~1.1-1.3 = brisk

# ── STT ───────────────────────────────────────────────────────────────────────
STT_PROVIDER=deepgram
STT_MODEL=nova-2

# ── System prompt (paste the content of ai-agent/prompt.md SYSTEM PROMPT block here)
# Required when running on Vercel (no filesystem access to prompt.md).
# On Vercel: paste multi-line value as a single-line JSON-escaped string,
# or set it as a multi-line env var in the Vercel dashboard.
SYSTEM_PROMPT=

# ── Webhook / server ──────────────────────────────────────────────────────────
# On Vercel this is your deployment URL: https://<project>.vercel.app/vapi
SERVER_URL=https://YOUR_VERCEL_DEPLOYMENT.vercel.app/vapi
SERVER_SECRET=change-me-long-random

# ── Admin (protect /swap, /deploy, /leads) ────────────────────────────────────
CONTROL_ADMIN_TOKEN=change-me-admin-token
CONTROL_PORT=8080            # local only; Vercel ignores this

# ── avr-ami (optional — for Asterisk-level transfer fallback) ─────────────────
# Leave empty on Vercel unless you expose avr-ami publicly.
AVR_AMI_URL=
